libzync: libsecp256k1 0.5.1 batch-verification hooks, applied ON TOP of 0012, 0013, 0005, 0006, 0008.

  HAZYNC_BATCH_ECDSA  ecdsa_impl.h                 after r,s != 0: hand (e, s, Q, r) to hazync_batch_defer
                      modules/schnorrsig/main_impl.h  after e is computed: hand (s, -e, P, r_x)
                      modules/extrakeys/main_impl.h   BIP341 tweak check: hand (t, 1, P, Q.x) with Q's parity

A return of 1 = "deferred into the end-of-chunk batch" (prover/methods/guest/src/batch_ecdsa.rs);
anything else falls through to libsecp's own verification, unchanged.
⛔ The hooks pass field and scalar LIMBS, so they REQUIRE the 8x32 field_bigint2 backend (0012) and
libsecp's 8x32 scalars (rv32). The guest build refuses HAZYNC_BATCH_ECDSA without HAZYNC_FIELD_BIGINT2.

diff -ruN a/src/ecdsa_impl.h b/src/ecdsa_impl.h
--- a/src/ecdsa_impl.h
+++ b/src/ecdsa_impl.h
@@ -204,6 +204,21 @@
     if (secp256k1_scalar_is_zero(sigr) || secp256k1_scalar_is_zero(sigs)) {
         return 0;
     }
+#ifdef HAZYNC_BATCH_ECDSA
+    {
+        secp256k1_ge q = *pubkey;
+        extern int hazync_batch_defer(int kind, const uint32_t *u1, const uint32_t *u2,
+                                      const uint32_t *qx, const uint32_t *qy, const uint32_t *r);
+        secp256k1_fe_normalize_var(&q.x);
+        secp256k1_fe_normalize_var(&q.y);
+        /* kind 2: (e, s, Q, r) BEFORE libsecp's scalar inverse and the two scalar products --
+         * the batch computes u1 = e/s and u2 = r/s on the coprocessor, for a few hundred cycles
+         * against ~2.7k of libsecp's software scalar arithmetic. On fallback libsecp does it all. */
+        if (hazync_batch_defer(2, message->d, sigs->d, q.x.n, q.y.n, sigr->d) == 1) {
+            return 1;
+        }
+    }
+#endif /* HAZYNC_BATCH_ECDSA */
 
 #ifdef HAZYNC_SCALAR_INV_ACCEL
     {
