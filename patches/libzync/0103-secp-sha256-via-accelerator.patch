+ * Used by BIP340's challenge hash and every tagged hash libsecp computes in the guest. */
+extern void sys_sha_compress(uint32_t*, const uint32_t*, const uint32_t*, const uint32_t*);
+static void secp256k1_sha256_transform(uint32_t* s, const unsigned char* buf) {
+    uint32_t st[8], blk[16];
+    int i;
+    for (i = 0; i < 8; i++) st[i] = __builtin_bswap32(s[i]);
+    __builtin_memcpy(blk, buf, 64);
+    sys_sha_compress(st, st, blk, blk + 8);
+    for (i = 0; i < 8; i++) s[i] = __builtin_bswap32(st[i]);
+}
+#else
