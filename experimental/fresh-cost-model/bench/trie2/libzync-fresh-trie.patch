+/// fresh-trie lever (SAME digest): SHA-256 of a byte string on OpenVM's SHA-256 extension (native-word state).
+#[cfg(all(target_os = "zkvm", feature = "ovm_sha"))]
+pub fn sha256_ovm(b: &[u8]) -> [u8; 32] {
+    extern "C" { fn zkvm_sha256_impl(state: *const u8, input: *const u8, output: *mut u8); }
+    let mut st: [u32; 8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
+    let full = b.len() / 64;
+    let mut blk = [0u32; 16];
+    for i in 0..full {
+        unsafe {
+            core::ptr::copy_nonoverlapping(b.as_ptr().add(64 * i), blk.as_mut_ptr() as *mut u8, 64);
+            zkvm_sha256_impl(st.as_ptr() as *const u8, blk.as_ptr() as *const u8, st.as_mut_ptr() as *mut u8);
+        }
+    }
+    let rest = &b[64 * full..];
+    let mut tail = [0u8; 128];
+    tail[..rest.len()].copy_from_slice(rest);
+    tail[rest.len()] = 0x80;
+    let n = if rest.len() + 9 <= 64 { 64 } else { 128 };
+    tail[n - 8..n].copy_from_slice(&((b.len() as u64) * 8).to_be_bytes());
+    for c in tail[..n].chunks_exact(64) {
+        unsafe {
+            core::ptr::copy_nonoverlapping(c.as_ptr(), blk.as_mut_ptr() as *mut u8, 64);
+            zkvm_sha256_impl(st.as_ptr() as *const u8, blk.as_ptr() as *const u8, st.as_mut_ptr() as *mut u8);
+        }
+    }
+    let mut o = [0u8; 32];
+    for i in 0..8 { o[4 * i..4 * i + 4].copy_from_slice(&st[i].to_be_bytes()); }
+    o
+}
