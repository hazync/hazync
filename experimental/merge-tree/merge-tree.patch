+/// EXPERIMENT (experimental/merge-tree): see `mt-join` in main().
+fn mt_join(mode: u32, k: usize, n_utxo: usize, n_block: usize) {
+    use risc0_zkvm::{default_executor, ReceiptClaim};
+    let mut seed = 0x9e3779b97f4a7c15u64;
+    let mut rnd32 = || -> [u8; 32] { let mut o = [0u8; 32]; for b in o.iter_mut() { seed ^= seed << 13; seed ^= seed >> 7; seed ^= seed << 17; *b = seed as u8; } o };
+    // profile: bit0 libzync, bit4 coinlog, bit5 trie, bit6 utxohash (mainnet product image)
+    let profile = 1 | 1 << 4 | 1 << 5 | 1 << 6;
+    let mut states: Vec<ChainState> = Vec::new();
+    for i in 0..k.max(1) {
+        let anchor_id = if i == 0 { rnd32() } else { link_digest(&states[i - 1]) };
+        states.push(ChainState {
+            kind: KIND_CHAIN, version: CHAIN_STATE_VERSION, tip_hash: rnd32(),
+            utxo_roots: (0..n_utxo).map(|_| Some(rnd32())).collect(), utxo_leaves: 2_500_000_000 + i as u64,
+            utxo_value: 1_990_000_000_000_000, cum_work: rnd32(), height: 900_000 + i as u32,
+            prev_nbits: 0x17030ecd, prev_time: 1_750_000_000, epoch_start: 1_749_000_000,
+            recent_times: (0..11).map(|t| 1_750_000_000 + t).collect(), anchor_id, self_id: METHOD_ID,
+            live_set: 1, live_hash: [7; 16], trie_root: rnd32(), smt_root: rnd32(), max_time: 1_750_000_000,
+            profile, block_roots: (0..n_block).map(|_| Some(rnd32())).collect(), block_leaves: 900_001 + i as u64,
+            lineage: [0; 32],
+        });
+    }
+    let journals: Vec<Vec<u8>> = states.iter().map(state_journal_bytes).collect();
+    let mut b = ExecutorEnv::builder();
+    b.segment_limit_po2(seg_po2());
+    match mode {
+        18 => {
+            assert!(k == 2, "mode 18 joins exactly two");
+            for j in &journals { b.add_assumption(ReceiptClaim::ok(METHOD_ID, j.clone())); }
+            b.write(&18u32).unwrap(); b.write(&METHOD_ID).unwrap();
+            b.write(&journals[0]).unwrap(); b.write(&journals[1]).unwrap();
+        }
+        19 => {
+            for j in &journals { b.add_assumption(ReceiptClaim::ok(METHOD_ID, j.clone())); }
+            b.write(&19u32).unwrap(); b.write(&METHOD_ID).unwrap(); b.write(&(k as u32)).unwrap();
+            for j in &journals { b.write(j).unwrap(); }
+        }
+        20 => { b.write(&20u32).unwrap(); b.write(&0u32).unwrap(); }
+        _ => panic!("mt-join: mode 18, 19 or 20"),
+    }
+    let s = default_executor().execute(b.build().unwrap(), METHOD_ELF).expect("mt-join execute");
+    if mode != 20 {
+        let st: ChainState = s.journal.decode().expect("joined state");
+        assert!(st.anchor_id == states[0].anchor_id && st.height == states[k - 1].height, "mt-join: unexpected output");
+    }
+    let user: u64 = s.segments.iter().map(|g| g.cycles as u64).sum();
+    let padded: u64 = s.segments.iter().map(|g| 1u64 << g.po2).sum();
+    println!("MT_JOIN mode={mode} k={k} utxo_roots={n_utxo} block_roots={n_block} journal_bytes={} segments={} user_cycles={user} padded_cycles={padded} po2s={:?}",
+             journals.first().map_or(0, |j| j.len()), s.segments.len(), s.segments.iter().map(|g| g.po2).collect::<Vec<_>>());
+}
