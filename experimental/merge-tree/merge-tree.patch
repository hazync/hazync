+/// EXPERIMENT (experimental/merge-tree): mode 19, a k-ary join. Exactly the checks of k-1 chained mode-18 joins, done in
+/// one session: every part verified (one env::verify each), decoded and checked as join() does, each part required to
+/// start where the previous one ends; commits the LAST state with the FIRST's anchor_id.
+#[cfg(feature = "libzync")]
+fn join_k() {
+    let self_id: [u32; 8] = env::read();
+    let k: u32 = env::read();
+    assert!(k >= 2, "join_k: k >= 2");
+    let decode = |b: &[u8]| -> ChainState {
+        assert!(b.len() % 4 == 0, "join: journal is not whole words");
+        let w: Vec<u32> = b.chunks_exact(4).map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]])).collect();
+        let st: ChainState = risc0_zkvm::serde::from_slice(&w).expect("join: decode");
+        assert!(st.kind == KIND_CHAIN, "join: journal is not a ChainState (domain tag)");
+        assert!(st.version == CHAIN_STATE_VERSION, "join: ChainState version {}", st.version);
+        assert!(st.self_id == self_id, "join: proof recursed against another image");
+        assert!(st.profile == chain_profile(), "join: profile mismatch");
+        st
+    };
+    let first: Vec<u8> = env::read();
+    env::verify(self_id, &first).expect("join: part 0 invalid");
+    let f = decode(&first);
+    let anchor = f.anchor_id;
+    let mut l = f;
+    for _ in 1..k {
+        let next: Vec<u8> = env::read();
+        env::verify(self_id, &next).expect("join: part invalid");
+        let r = decode(&next);
+        assert!(l.lineage == r.lineage, "join: lineage mismatch");
+        assert!(link_digest(&l) == r.anchor_id, "join: a part does not start where the previous one ends");
+        l = r;
+    }
+    l.anchor_id = anchor;
+    env::commit(&l);
+}
