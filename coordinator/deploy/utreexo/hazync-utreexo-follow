#!/bin/bash
# Keep the utreexo zyncAPP's proof near Bitcoin's tip, for Floresta (docs/libzync/UTREEXO_ZAPP.md §10).
#
# What is served: ONE receipt, the newest, proving Floresta's accumulator (roots, leaf count) after block H, where
#   H = min(node tip - MARGIN, the core proof's height T)
# and a small JSON naming it. Each update is a STEP: it verifies the previous receipt inside the zkVM and applies blocks
# P+1..H to the roots it proves (rustreexo Stump::modify, block by block), so the newest receipt alone proves the whole
# chain from the base (a walk from genesis, proved once with `zyncapp utreexo-prove`, installed with --set-base). A new
# receipt replaces the last; the last KEEP proven states stay in $D/state for reorgs.
#
# State: each proven height is a directory $D/state/<H>-<hash>/ holding `rcpt` and `meta` ("H hash"); $D/latest and
# $D/base are symlinks to one, switched by an atomic rename, so a receipt and its meta never disagree (review L2).
#
#   hazync-utreexo-follow                                   step to the new H, verify, publish (the timer runs this)
#   hazync-utreexo-follow --init                            create $D and $BLOCKS and mark $BLOCKS as this follower's own
#   hazync-utreexo-follow --set-base <receipt> <H> <hash>   install a base (a final run of the base image; verified first)
#
# Nothing is published unless `zapp-utreexo verify`, with the node's own hashes at H and at the core tip, says OK (or
# DEMO when ALLOW_DEMO=1: below Core's minimum work every proof is DEMO).
#
# Reorgs: the published block H must stay on the node's chain. When it does not, the follower falls back to the newest
# kept state (then the base) whose block is still the node's and steps forward from there on the new branch (the states
# and published receipts above it are moved to $D/orphaned/, not deleted); a node RPC failure or a node below the proven
# height is an error, never a reorg (review M1);
# below the base it stops with an error (a new base is needed). H trails the node's tip by MARGIN, so a reorg shallower
# than MARGIN never touches a published height.
set -euo pipefail
# errexit also inside $(…) (bash clears it there otherwise: a failed cp inside new_state went on, review of f99c301 M1)
shopt -s inherit_errexit

D=${UTREEXO_DIR:-/var/lib/hazync-utreexo}
BIN=${UTREEXO_BIN:-/opt/hazync-utreexo/bin}
ZYNCAPP=${ZYNCAPP:-$BIN/zyncapp}
VERIFY=${VERIFY:-$BIN/zapp-utreexo}
# the tip guest ELF (empty: the one built into zyncapp); its image id is what the checker must trust
ELF=${ELF:-}
WANT_ELF=${WANT_ELF:-}
# the base image id (empty: the one built into zyncapp), as --base-id and for the checker's --base-image
BASE_ID=${BASE_ID:-}
# the tip image id the checker trusts (empty: zapp-utreexo's built-in)
TIP_IMAGE=${TIP_IMAGE:-}
# the core receipt the steps rest on: the newest genesis-anchored chain proof (the spine's copy)
CORE=${CORE:-/var/lib/hazync-lz/spine/spine.bin}
# the follower's OWN block files: a reorg moves the old branch's files out of it (never point it at a shared directory)
BLOCKS=${BLOCKS:-$D/blocks}
# fetch block files lo..hi into $BLOCKS (prover/fetch_block_rpc.py range; the node needs txindex). Only the bodies of
# the step's blocks are fetched; the link to the core tip is headers only (getblockheader), review L4
FETCH=${FETCH:-python3 $BIN/fetch_block_rpc.py range}
# the witness source (zyncapp --source): forest = the production source (UTREEXO_ZAPP.md §10.5.1: the compact forest,
# kept as $D/forest-<H>-<hash>.bin, the spent coins from the block files' prevouts); native = the test-scale MemForest
# replay (all live coins in memory), kept for comparison
WITNESS_SOURCE=${WITNESS_SOURCE:-forest}
# how many forest caches to keep (the newest by height, each the state of a kept proof). A step starts from the newest
# kept forest at or below its previous height and replays forward from there, so a fall-back to any kept state needs a
# forest at or below it: the default keeps one per kept state (KEEP + 1, latest included). Each is the size of the
# forest (~11 GB at the tip, ESTIMATE, UTREEXO_ZAPP.md §10.5.1)
FOREST_KEEP=${FOREST_KEEP:-}
# a replay from GENESIS (no kept forest at or below the previous height) of more than this many blocks is refused unless
# ALLOW_GENESIS_REPLAY=1: at the tip it is ~970,000 bodies fetched with prevouts onto this disk (review F1)
GENESIS_REPLAY_MAX=${GENESIS_REPLAY_MAX:-100000}
ALLOW_GENESIS_REPLAY=${ALLOW_GENESIS_REPLAY:-0}
# the forest's heap (zyncapp's UTREEXO_TIP_WITNESS line) is written to $D/forest-heap after every step; above this a
# warning is logged, and hazync-check-utreexo-follow alerts (default 12 GiB: half the unit's MemoryMax, review F3)
FOREST_HEAP_WARN_BYTES=${FOREST_HEAP_WARN_BYTES:-12884901888}
# forests moved to orphaned/ (a fall-back, a new base) are deleted this many minutes after they were moved (review F7)
ORPHANED_FOREST_MIN=${ORPHANED_FOREST_MIN:-2880}
# PRUNE_BLOCKS=1: delete block files at or below the proven height once a forest cache is there (a step from an older
# kept forest fetches the bodies above it again)
PRUNE_BLOCKS=${PRUNE_BLOCKS:-0}
BITCOIN_CLI=${BITCOIN_CLI:-bitcoin-cli -conf=/etc/bitcoin/bitcoin.conf -datadir=/var/lib/bitcoind}
MARGIN=${MARGIN:-6}
# at most this many blocks per step (a catch-up takes several runs)
MAX_STEP=${MAX_STEP:-2016}
KEEP=${KEEP:-12}
[ -n "$FOREST_KEEP" ] || FOREST_KEEP=$((KEEP + 1))
ALLOW_DEMO=${ALLOW_DEMO:-0}
# DRY_RUN=1: stop after choosing H (and after any reorg fall-back), proving nothing
# PUBLISHED_KEEP: how many published receipts stay in pub/ (the most recently published; never the current one)
PUBLISHED_KEEP=${PUBLISHED_KEEP:-3}
NETWORK=${NETWORK:-mainnet}
PUBLISH=${PUBLISH:-}
PUBLISH_KEY=${PUBLISH_KEY:-/root/.ssh/hazync_utreexo_publish}

# log and die write to STDERR: a message from inside $(…) must never become the captured value (review L1)
log () { echo "[$(date -u +%FT%TZ)] $*" >&2; }
die () { log "ERROR: $*"; exit 1; }
# stdin from /dev/null: an ssh or docker BITCOIN_CLI must never swallow a loop's input (review of 7806f4b, 4)
cli () { $BITCOIN_CLI "$@" </dev/null; }
# the node's hash at h; an RPC failure (warm-up, timeout, h above its tip) is an ERROR, never "another hash" (review M1)
node_hash () {
  local x; x=$(cli getblockhash "$1" 2>/dev/null) || die "the node did not answer getblockhash $1 (not a reorg: an RPC failure or a node below $1)"
  [[ "$x" =~ ^[0-9a-f]{64}$ ]] || die "the node's getblockhash $1 is not a hash: '$x'"
  echo "$x"
}

# $BLOCKS is this follower's own: it moves and deletes files there (reorgs, stale blocks, PRUNE_BLOCKS). It must hold
# the marker that --init writes; a directory without it (shared, mistyped, a symlink to another tree) is refused
# before anything is touched (review of 0d9683a LOW 3)
MARK=.hazync-utreexo-blocks
if [ "${1:-}" = "--init" ]; then
  mkdir -p "$D" "$BLOCKS" || die "mkdir"
  ours="owned by the hazync-utreexo-follow of $(cd "$D" && pwd -P)"
  if [ -f "$BLOCKS/$MARK" ]; then
    # an existing marker is never overwritten: a mistyped BLOCKS must not claim another follower's directory (review of
    # 7806f4b, 2)
    [ "$(cat "$BLOCKS/$MARK")" = "$ours" ] || die "$BLOCKS/$MARK names another follower ('$(cat "$BLOCKS/$MARK")'), not $D"
  else
    [ -z "$(ls -A "$BLOCKS")" ] || die "$BLOCKS is not empty and has no $MARK: not initialising a directory that may be shared"
    printf '%s\n' "$ours" > "$BLOCKS/$MARK" || die "cannot write $BLOCKS/$MARK"
  fi
  log "initialised: $D, block files in $BLOCKS"
  exit 0
fi
[ -d "$BLOCKS" ] && [ -f "$BLOCKS/$MARK" ] || die "$BLOCKS has no $MARK: run --init first (it must be this follower's own directory)"
[ "$(cat "$BLOCKS/$MARK")" = "owned by the hazync-utreexo-follow of $(cd "$D" 2>/dev/null && pwd -P)" ] \
  || die "$BLOCKS/$MARK names another follower ('$(cat "$BLOCKS/$MARK")')"
mkdir -p "$D/work" "$D/pub" "$D/state" "$D/orphaned"
exec 9>"$D/.lock"; flock -n 9 || { log "another run holds the lock"; exit 0; }

if [ -n "$ELF" ] && [ -n "$WANT_ELF" ]; then
  [ "$(sha256sum "$ELF" | cut -c1-64)" = "$WANT_ELF" ] || die "$ELF is not the tip ELF $WANT_ELF"
fi
NETFLAG=(); [ "$NETWORK" = signet ] && NETFLAG=(--signet)
[[ "$FOREST_KEEP" =~ ^[1-9][0-9]*$ ]] || die "FOREST_KEEP must be 1 or more (the cache of the newest state is always kept)"
[[ "$GENESIS_REPLAY_MAX" =~ ^[0-9]+$ ]] && [[ "$FOREST_HEAP_WARN_BYTES" =~ ^[0-9]+$ ]] && [[ "$ORPHANED_FOREST_MIN" =~ ^[0-9]+$ ]] \
  || die "GENESIS_REPLAY_MAX, FOREST_HEAP_WARN_BYTES and ORPHANED_FOREST_MIN must be numbers"
case "$WITNESS_SOURCE" in forest|native) ;; *) die "WITNESS_SOURCE: forest or native";; esac

# new_state <receipt> <H> <hash>: a state directory (written, synced, then renamed into place); prints its name. Every
# step is checked: a half-written state is never installed (review M1)
new_state () {
  local n="$2-$3" t="$D/state/.$2-$3.tmp"
  rm -rf "$t" || return 1
  mkdir "$t" || return 1
  cp "$1" "$t/rcpt" || return 1
  printf '%s %s\n' "$2" "$3" > "$t/meta" || return 1
  [ -s "$t/rcpt" ] && cmp -s "$1" "$t/rcpt" || return 1
  sync "$t/rcpt" "$t/meta" "$t" || return 1
  rm -rf "${D:?}/state/$n" || return 1
  mv "$t" "$D/state/$n" || return 1
  sync "$D/state" || return 1
  echo "$n"
}
# point <link> <state name>: switch $D/<link> to it in one rename (only to a complete state), then sync the directory
point () {
  [ -s "$D/state/$2/rcpt" ] && [ -s "$D/state/$2/meta" ] || die "refusing to point $1 at an incomplete state $2"
  ln -sfn "state/$2" "$D/.$1.tmp" || die "ln $1"
  mv -T "$D/.$1.tmp" "$D/$1" || die "mv $1"
  sync "$D" || die "sync $D"
}

# checker <receipt> <H> <hash> [json]: verify with the node's hash at H and at the receipt's OWN core tip T (read from
# the receipt itself and then checked against the node: review L1). Prints "OK|DEMO T TX" (or the JSON when asked).
checker () {
  local r=$1 h=$2 x=$3 base=() out t tx
  if [ "$h" -gt "${B:-0}" ]; then
    [ -n "$TIP_IMAGE" ] && base+=(--image "$TIP_IMAGE"); [ -n "$BASE_ID" ] && base+=(--base-image "$BASE_ID")
  else
    [ -n "$BASE_ID" ] && base+=(--image "$BASE_ID")   # a base receipt: the base image is ITS image (review L4)
  fi
  out=$("$VERIFY" verify "$r" --network "$NETWORK" --expect "$h:$x" "${base[@]}" --json --allow-demo 2>/dev/null) || [ $? = 2 ] || return 1
  t=$(echo "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["core_height"])') || return 1
  # errexit does not apply here (callers run `V=$(checker …) || die`), so every substitution is checked explicitly
  # (review of 0d9683a LOW 1)
  [[ "$t" =~ ^[0-9]+$ ]] || return 1
  tx=$(node_hash "$t") || return 1
  [[ "$tx" =~ ^[0-9a-f]{64}$ ]] || return 1
  local args=(verify "$r" --network "$NETWORK" --expect "$h:$x" "${base[@]}")
  if [ "$t" -gt "$h" ]; then args+=(--expect-tip "$t:$tx"); fi
  [ "${4:-}" = json ] && { "$VERIFY" "${args[@]}" --json --allow-demo 2>/dev/null || [ $? = 2 ]; return; }
  out=$("$VERIFY" "${args[@]}" 2>&1) || true
  if echo "$out" | grep -q "^ZAPP_UTREEXO_OK: $NETWORK Utreexo accumulator (Floresta's) after block $h $x "; then echo "OK $t $tx"; return 0; fi
  if [ "$ALLOW_DEMO" = 1 ] && echo "$out" | grep -q "^ZAPP_UTREEXO_DEMO: $NETWORK Utreexo accumulator (Floresta's) after block $h $x "; then echo "DEMO $t $tx"; return 0; fi
  echo "$out" | grep -E 'FAIL|ZAPP_UTREEXO' | tail -3 >&2
  return 1
}

# check_blocks <lo> <hi> <why>: every CACHED block file in lo..hi must be the node's block at its height (header hash
# == getblockhash); a file that is not (an old branch's, left by an interrupted fall-back, a failed step before a
# reorg, or a reorg below the base) moves to orphaned/ and is fetched again. A file above the node's tip moves too.
# Block files are never trusted because they exist (review of 0d9683a MED)
check_blocks () {
  local lo=$1 hi=$2 why=$3 moved=0 h x nx O='' list=$D/work/check_blocks.list
  [ "$lo" -le "$hi" ] || return 0
  # the list first, its status checked: a python failure is an error, never "nothing to check" (review of 7806f4b, 4)
  python3 - "$BLOCKS" "$lo" "$hi" > "$list" <<'PY' || { log "listing the cached block files failed"; return 1; }
import sys, os, json, struct, hashlib
d, lo, hi = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
for h in range(lo, hi + 1):
    p = f'{d}/block_{h}.json'
    if not os.path.exists(p): continue
    try:
        v = json.load(open(p)); assert v['height'] == h
        hdr = struct.pack('<i', v['version']) + bytes.fromhex(v['prev'])[::-1] + bytes.fromhex(v['merkle'])[::-1] + struct.pack('<III', v['time'], v['bits'], v['nonce'])
        print(h, hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex())
    except Exception:
        print(h, 'unreadable')
PY
  while read -r h x; do
    if [ "$h" -le "$NT" ]; then nx=$(node_hash "$h") || return 1; else nx=; fi
    if [ "$nx" != "$x" ]; then
      [ -n "$O" ] || { O=$D/orphaned/stale-$why-$(date +%s)/blocks; mkdir -p "$O" || return 1; }
      mv "$BLOCKS/block_$h.json" "$O/" || return 1
      moved=$((moved + 1))
    fi
  done < "$list"
  [ "$moved" = 0 ] || log "moved $moved cached block file(s) in $lo..$hi that are not the node's chain to $O ($why)"
}

# publish_latest <H> <hash> <verdict line> <seconds>: copy latest to pub/ (utreexo-<H>.rcpt, latest.rcpt), write
# latest.json last, retention, upload, record. Used after a step, for a republish, and straight after a fall-back
publish_latest () {
  local h=$1 hx=$2 v=$3 secs=$4 name="utreexo-$1.rcpt" vj k f
  cp "$D/latest/rcpt" "$PUB/$name.new" || die "cp $name"
  mv "$PUB/$name.new" "$PUB/$name" || die "mv $name"
  cp "$D/latest/rcpt" "$PUB/latest.rcpt.new" || die "cp latest.rcpt"
  mv "$PUB/latest.rcpt.new" "$PUB/latest.rcpt" || die "mv latest.rcpt"
  vj=$(checker "$PUB/$name" "$h" "$hx" json) || die "the published receipt does not verify"
  # the checker's JSON goes in through the environment, never into the program text (it holds escaped quotes)
  VJ="$vj" python3 - "$PUB" "$name" "$secs" "$NETWORK" "${v%% *}" <<'PY' || die "latest.json"
import json, sys, time, os, hashlib
p, name, secs, net, verdict = sys.argv[1:]
v = json.loads(os.environ['VJ'])
b = open(os.path.join(p, name), 'rb').read()
doc = {'network': net, 'height': v['height'], 'block_hash': v['block_hash'], 'leaves': v['leaves'], 'roots': v['roots'],
       'core_height': v['core_height'], 'mode': v.get('mode', 'base'), 'steps': v.get('steps', 0), 'base_height': v.get('base_height', v['height']),
       'receipt': name, 'sha256': hashlib.sha256(b).hexdigest(), 'bytes': len(b), 'verdict_here': verdict.lower(),
       'proved_at': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'prove_seconds': int(secs)}
open(os.path.join(p, 'latest.json.new'), 'w').write(json.dumps(doc) + '\n')
os.replace(os.path.join(p, 'latest.json.new'), os.path.join(p, 'latest.json'))
PY
  # retention (review M2): the PUBLISHED_KEEP most recently published receipts (by publish time), never the current one;
  # receipts above H (an orphaned branch after a fall-back) were already moved aside
  k=1
  for f in $(cd "$PUB" && ls -t utreexo-*.rcpt); do
    [ "$f" = "$name" ] && continue
    if [ "$k" -lt "$PUBLISHED_KEEP" ]; then k=$((k + 1)); else rm -f "$PUB/$f"; fi
  done
  if [ -n "$PUBLISH" ]; then
    # receipts first (latest.json excluded, so the receiver's copy is not touched), then latest.json alone: a reader of
    # latest.json never finds a name that is not there yet (review L3). The target must be dedicated (--delete-after)
    local ssh_=(-e "ssh -i $PUBLISH_KEY -o BatchMode=yes")
    rsync -rt --delay-updates --delete-after --exclude latest.json "${ssh_[@]}" "$PUB/" "$PUBLISH" || die "publish to $PUBLISH failed"
    rsync -t "${ssh_[@]}" "$PUB/latest.json" "$PUBLISH" || die "publish of latest.json to $PUBLISH failed"
  fi
  echo "$h $hx" > "$D/published"
  log "published block $h $hx (${v%% *})"
}
PUB=$D/pub

if [ "${1:-}" = "--set-base" ]; then
  R=${2:?receipt}; H=${3:?height}; X=${4:?hash}
  NX=$(node_hash "$H"); [ "$NX" = "$X" ] || die "the node's hash at $H is not $X"
  B=$H
  bimg=(); [ -n "$BASE_ID" ] && bimg=(--image "$BASE_ID")
  out=$("$VERIFY" verify "$R" --network "$NETWORK" --expect "$H:$X" "${bimg[@]}" --json --allow-demo 2>/dev/null) || [ $? = 2 ] || die "the base does not verify as block $H $X"
  echo "$out" | python3 -c 'import json,sys; assert "mode" not in json.load(sys.stdin)' || die "not a base receipt (a tip receipt?)"
  V=$(checker "$R" "$H" "$X") || die "the base is not OK$([ "$ALLOW_DEMO" = 1 ] && echo ' or DEMO') for block $H $X with the node's chain"
  # the new base's state first, both links to it, THEN the previous base's states move aside (kept, not deleted)
  n=$(new_state "$R" "$H" "$X") || die "cannot write the base's state"
  point base "$n"; point latest "$n"
  O=$D/orphaned/base-$(date +%s); mkdir -p "$O"
  for d in "$D"/state/[0-9]*-*; do [ -e "$d" ] && [ "$(basename "$d")" != "$n" ] && { mv "$d" "$O/" || die "mv $d"; }; done
  # the old base's forests move aside with its states (review F1: never deleted here; orphaned/ is pruned by age)
  for f in "$D"/forest-*.bin "$D/forest.bin" "$D/work/forest.next" "$D/work/forest.next.pending"; do
    if [ -f "$f" ]; then mv "$f" "$O/" || die "mv $f"; fi
  done
  rm -f "$D/published"
  # block files above the new base may be another branch's (a reorg below the old base): checked the same way
  NT=$(cli getblockcount) || die "the node did not answer getblockcount"
  [[ "$NT" =~ ^[0-9]+$ ]] || die "getblockcount: '$NT'"   # a garbage answer must not make every file "above the tip"
  top=$(find "$BLOCKS" -maxdepth 1 -name 'block_*.json' | sed 's/.*block_\([0-9]*\)\.json$/\1/' | sort -n | tail -1)   # find: no files is not an error (ls would exit 2 under pipefail)
  check_blocks $((H + 1)) "${top:-0}" set-base || die "checking the cached block files"
  log "base installed: block $H $X ($V)"
  exit 0
fi

[ -L "$D/base" ] && [ -L "$D/latest" ] || die "no base: run --set-base first"
read -r B BX < "$D/base/meta"
read -r P PX < "$D/latest/meta"

# forest_head <file>: "<height> <block hash>" from a saved source's header (HZUFOR01 or HZUTIP01: magic 8, height u32 LE,
# the block hash 32 bytes in internal order), or nothing
forest_head () {
  python3 - "$1" <<'PY' 2>/dev/null
import sys, struct
b = open(sys.argv[1], 'rb').read(44)
if len(b) == 44 and b[:8] in (b'HZUFOR01', b'HZUTIP01'):
    print(struct.unpack('<I', b[8:12])[0], b[12:44][::-1].hex())
PY
}
# review F1 (a): a run killed between `point latest` and the forest's rename leaves the forest of the new latest in
# work/forest.next. It is adopted here (its own header must name latest's height and block), never deleted
if [ -f "$D/work/forest.next" ]; then
  if [ "$(forest_head "$D/work/forest.next")" = "$P $PX" ] && [ ! -f "$D/forest-$P-$PX.bin" ]; then
    mv "$D/work/forest.next" "$D/forest-$P-$PX.bin" || die "mv forest.next"
    sync "$D/forest-$P-$PX.bin" "$D" || die "sync $D"
    log "adopted work/forest.next as the forest of latest ($P $PX): the last run stopped before renaming it"
  fi
fi
# review F7: forests moved to orphaned/ more than ORPHANED_FOREST_MIN minutes ago go (~11 GB each at the tip), on every
# run; the rest of orphaned/ (receipts, states, block files) is small and stays
find "$D/orphaned" -name 'forest*' -type f -cmin +"$ORPHANED_FOREST_MIN" -print -delete 2>/dev/null | sed 's/^/pruned orphaned forest /' >&2 || true
NT=$(cli getblockcount) || die "the node did not answer getblockcount"
[[ "$NT" =~ ^[0-9]+$ ]] || die "getblockcount: '$NT'"
[ "$NT" -ge "$P" ] || die "the node's tip $NT is below the proven height $P (still syncing?): not a reorg, nothing done"
NBX=$(node_hash "$B"); [ "$NBX" = "$BX" ] || die "the base block $B $BX is no longer on the node's chain: install a new base"

# the newest kept state whose block is still on the node's chain (normally latest; after a reorg an older one). At the top
# level every node answer is an assignment, so with set -e an RPC failure stops the run instead of reading as "another
# hash"; inside functions called as `x=$(f …) || die` errexit does not apply, and they check each answer themselves
NPX_=$(node_hash "$P")
if [ "$NPX_" != "$PX" ]; then
  log "REORG: the proven block $P $PX is no longer the node's"
  NP=$B; NPX=$BX; NS=$(basename "$(readlink "$D/base")")
  for d in $(cd "$D/state" && ls -d [0-9]*-* 2>/dev/null | sort -n); do
    read -r h x < "$D/state/$d/meta"
    if [ "$h" -lt "$P" ] && [ "$h" -gt "$NP" ]; then nx=$(node_hash "$h"); [ "$nx" = "$x" ] && { NP=$h; NPX=$x; NS=$d; }; fi
  done
  # latest first (review L2), then what belongs to the orphaned branch moves aside: states, published receipts, the
  # cache, and the block files above the fork, which are the OLD branch's blocks (review M3)
  point latest "$NS"
  O=$D/orphaned/reorg-$P-$(date +%s); mkdir -p "$O/pub" "$O/blocks"
  for d in $(cd "$D/state" && ls -d [0-9]*-* 2>/dev/null); do
    h=${d%%-*}; if [ "$h" -gt "$NP" ]; then mv "$D/state/$d" "$O/" || die "mv state $d"; fi
  done
  for f in $(cd "$D/pub" && ls utreexo-*.rcpt 2>/dev/null); do
    h=${f#utreexo-}; h=${h%.rcpt}; if [ "$h" -gt "$NP" ]; then mv "$D/pub/$f" "$O/pub/" || die "mv $f"; fi
  done
  for f in $(cd "$BLOCKS" && ls block_*.json 2>/dev/null); do
    h=${f#block_}; h=${h%.json}; if [ "$h" -gt "$NP" ]; then mv "$BLOCKS/$f" "$O/blocks/" || die "mv $f"; fi
  done
  # forest caches ABOVE the fall-back height are the orphaned branch's; the one AT it (if kept) is where the step
  # starts, and those below stay for a deeper fall-back
  for f in "$D"/forest-*.bin "$D/forest.bin"; do
    [ -f "$f" ] || continue
    h=$(basename "$f"); h=${h#forest-}; h=${h%%-*}
    if [ "$f" = "$D/forest.bin" ] || [ "$h" -gt "$NP" ]; then mv "$f" "$O/" || die "mv $f"; fi
  done
  log "fell back to the kept proof of block $NP $NPX (orphaned states and receipts moved to $O); stepping forward on the node's branch"
  P=$NP; PX=$NPX
  # publish the fall-back state at once: pub/latest.json must not name the orphaned receipt while the new branch is
  # proved (review of 0d9683a LOW 4)
  FB=fallback
fi
if [ "${FB:-}" = fallback ] && [ "${DRY_RUN:-0}" != 1 ]; then
  # the kept receipt's own core tip may itself be on the orphaned branch (a reorg deeper than its link): then it cannot
  # be checked against this node, so it is not published, and the run carries on to the step, whose receipt (on the
  # node's branch) is published instead (review of 7806f4b, 1)
  if V=$(checker "$D/latest/rcpt" "$P" "$PX"); then
    publish_latest "$P" "$PX" "$V" 0
  else
    log "the fall-back proof of $P does not verify with this node's chain (its core tip was orphaned too?): not published; stepping on"
  fi
fi

CI=$("$ZYNCAPP" core-info "$CORE") || die "core-info $CORE"
T=$(echo "$CI" | sed -n 's/^CORE height=\([0-9]*\) .*/\1/p')
TX=$(echo "$CI" | sed -n 's/^CORE height=[0-9]* tip=\([0-9a-f]*\) .*/\1/p')
[ -n "$T" ] && [ -n "$TX" ] || die "core-info: $CI"
[ "$T" -le "$NT" ] || die "the core proof's tip $T is above the node's tip $NT (the node is behind)"
NTX=$(node_hash "$T"); [ "$NTX" = "$TX" ] || die "the core proof's tip $T $TX is not the node's block $T (a reorg below the core tip: wait for the next core proof)"
H=$(( NT - MARGIN < T ? NT - MARGIN : T ))
[ "$H" -gt $(( P + MAX_STEP )) ] && H=$(( P + MAX_STEP ))
log "target H=$H (proven $P, node tip $NT - margin $MARGIN, core tip $T, at most $MAX_STEP blocks per step)"
[ "${DRY_RUN:-0}" = 1 ] && exit 0
if [ "$H" -le "$P" ]; then
  log "nothing to do: proven $P, node tip $NT (margin $MARGIN), core tip $T"
  # a fall-back above may have moved latest: publish it
  [ "$(cat "$D/published" 2>/dev/null)" = "$P $PX" ] && exit 0
  H=$P
fi
HX=$(node_hash "$H")

if [ "$H" -gt "$P" ]; then
  # the bodies P+1..H (or 1..H when the source must replay from genesis: no forest cache at P), and the link
  # H+1..T as headers only
  # a forest is named by the height AND hash it is for, and only one whose block is the node's is used; the bodies from
  # its height + 1 (from 1 with none) are checked and fetched (review of 7806f4b, 3; review F1)
  # the newest kept forest at or below P whose block is the node's: the source replays forward from it (review F1 b)
  FC=; FH=0
  for f in $(cd "$D" && ls forest-*.bin 2>/dev/null | sort -t- -k2,2nr); do
    fh=${f#forest-}; fh=${fh%%-*}; fx=${f#forest-*-}; fx=${fx%.bin}
    [[ "$fh" =~ ^[0-9]+$ ]] && [ "$fh" -le "$P" ] || continue
    if [ "$fh" = "$P" ] && [ "$fx" = "$PX" ]; then FC=$D/$f; FH=$fh; break; fi
    if [ "$fh" -lt "$P" ] && [ "$(node_hash "$fh")" = "$fx" ]; then FC=$D/$f; FH=$fh; break; fi
  done
  if [ -z "$FC" ]; then
    # no kept forest: a replay from genesis, refused above GENESIS_REPLAY_MAX blocks unless allowed
    if [ "$P" -gt "$GENESIS_REPLAY_MAX" ] && [ "$ALLOW_GENESIS_REPLAY" != 1 ]; then
      die "no kept forest at or below $P: a replay from genesis of $P blocks (above GENESIS_REPLAY_MAX $GENESIS_REPLAY_MAX) needs ALLOW_GENESIS_REPLAY=1"
    fi
    log "no kept forest at or below $P: the source replays from genesis"
    FC=$D/forest-$P-$PX.bin
  elif [ "$FH" -lt "$P" ]; then
    log "the newest kept forest at or below $P is at $FH: the source replays $((FH + 1))..$P first"
  fi
  lo=$((FH + 1))
  check_blocks "$lo" "$H" step || die "checking the cached block files"
  missing=; for h in $(seq "$lo" "$H"); do [ -s "$BLOCKS/block_$h.json" ] || { missing=$h; break; }; done   # no `| head` (SIGPIPE under pipefail)
  if [ -n "$missing" ]; then $FETCH "$missing" "$H" "$BLOCKS" > "$D/work/fetch.log" 2>&1 || { tail -3 "$D/work/fetch.log"; die "fetch $missing..$H"; }; fi
  HDRS=$D/work/link_$((H + 1))_$T.txt; : > "$HDRS"
  for h in $(seq $((H + 1)) "$T"); do
    hx=$(node_hash "$h"); hh=$(cli getblockheader "$hx" false) || die "getblockheader $hx"
    printf '%s %s\n' "$h" "$hh" >> "$HDRS"
  done
  OUT=$D/work/step_$H.rcpt
  # the host reads the cache for (P, PX) and writes the one for H to work/forest.next, renamed to forest-<H>-<hash>.bin
  # only once latest points at H: a failed or killed run leaves the cache for P in place (review of 0d9683a LOW 2)
  rm -f "$D/work/forest.next" "$D/work/forest.next.pending"
  args=(utreexo-tip-prove "$BLOCKS" "$D/latest/rcpt" "$H" "$CORE" "$OUT" --cache "$FC" --cache-out "$D/work/forest.next" --headers "$HDRS"
        --source "$WITNESS_SOURCE" "${NETFLAG[@]}")
  [ -n "$ELF" ] && args+=(--elf "$ELF")
  [ -n "$BASE_ID" ] && args+=(--base-id "$BASE_ID")
  log "step $P -> $H (node tip $NT, core tip $T)"
  S=$(date +%s)
  "$ZYNCAPP" "${args[@]}" > "$D/work/prove.log" 2>&1 || { tail -5 "$D/work/prove.log" >&2; die "prove failed"; }
  SECS=$(( $(date +%s) - S ))
  V=$(checker "$OUT" "$H" "$HX") || die "the new step does not verify to the node's block $H $HX"
  log "proved and verified $((P + 1))..$H in $SECS s (${V%% *})"
  # review F3: the forest's heap at this height, for the check (and a warning here)
  heap=$(sed -n 's/^UTREEXO_TIP_WITNESS .* forest_heap_bytes=\([0-9]*\).*/\1/p' "$D/work/prove.log" | tail -1)
  if [ -n "$heap" ]; then
    echo "$heap $H" > "$D/forest-heap.new" && mv "$D/forest-heap.new" "$D/forest-heap"
    [ "$heap" -le "$FOREST_HEAP_WARN_BYTES" ] || log "WARNING: the forest holds $heap bytes of heap at $H, above FOREST_HEAP_WARN_BYTES $FOREST_HEAP_WARN_BYTES: raise MemoryMax before it is reached (UTREEXO_ZAPP.md §10.5.1)"
  fi
  n=$(new_state "$OUT" "$H" "$HX") || die "cannot write the state of $H (disk full?): latest stays at $P"
  point latest "$n"
  if [ -f "$D/work/forest.next" ]; then
    mv "$D/work/forest.next" "$D/forest-$H-$HX.bin" || die "mv forest.next"
    sync "$D/forest-$H-$HX.bin" "$D" || die "sync $D"   # the rename is durable before anything older is removed (F1 a)
    # the FOREST_KEEP newest caches by height (the new one first); a legacy forest.bin goes
    rm -f "$D/forest.bin"
    k=0
    for f in $(cd "$D" && ls forest-*.bin 2>/dev/null | sort -t- -k2,2nr); do
      k=$((k + 1)); [ "$k" -le "$FOREST_KEEP" ] || rm -f "${D:?}/$f"
    done
  fi
  # keep the KEEP newest states below latest, the base and latest itself
  keep_b=$(basename "$(readlink "$D/base")"); keep_l=$(basename "$(readlink "$D/latest")")
  old=(); for d in $(cd "$D/state" && ls -d [0-9]*-* | sort -n); do [ "$d" != "$keep_b" ] && [ "$d" != "$keep_l" ] && old+=("$d"); done
  while [ "${#old[@]}" -gt "$KEEP" ]; do rm -rf "${D:?}/state/${old[0]}"; old=("${old[@]:1}"); done
  if [ "$PRUNE_BLOCKS" = 1 ] && [ -f "$D/forest-$H-$HX.bin" ]; then
    (cd "$BLOCKS" && for f in block_*.json; do h=${f#block_}; h=${h%.json}; [ "$h" -le "$H" ] && rm -f "$f"; done; true)
  fi
  rm -f "$HDRS"
else
  SECS=0
  V=$(checker "$D/latest/rcpt" "$H" "$HX") || die "the kept proof of $H does not verify to the node's block $H $HX"
fi

rm -f "$D/work"/step_*.rcpt
publish_latest "$H" "$HX" "$V" "$SECS"
