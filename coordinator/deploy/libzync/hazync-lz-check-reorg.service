# REORG.md §17-§18 (review round 3, M2): pages while the coordinator's reorg backstop is latched: the board holds a
# verified range that is not on prep's chain (a reorg the board did not follow). The coordinator keeps the alert in its
# database (meta reorg_alert) until a rewind below it is applied; this check only reads it (read-only, as hazync).
[Unit]
Description=Hazync libzync board integrity: every verified range in the reorg window is on prep's chain
OnFailure=hazync-alert@%n.service

[Service]
Type=oneshot
User=hazync
Environment=COORD_DB=/var/lib/hazync-lz/coordinator.db
# D1 (REORG.md §19): the tip run (the paper prep, LZ_HI=follow) standing still below the node's tip for an hour pages
Environment=CHECK_TIP_RUN_PREP_TIP=/var/lib/libzync-fast/out/PREP_TIP.json
Environment=CHECK_TIP_RUN_STATE=/var/lib/hazync-lz/check-tip-run.json
# a stall the tip run's leaf window explains (no one proves tip blocks) is said so (review, MEDIUM 3)
Environment=CHECK_TIP_RUN_LEAVES=/srv/bulk/libzync-prep/leaves
Environment=CHECK_TIP_RUN_LEAF_WINDOW=4320
ExecStart=/usr/bin/python3 /opt/hazync-lz/coordinator/deploy/libzync/hazync-lz-check-reorg.py
Nice=10
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=2min
