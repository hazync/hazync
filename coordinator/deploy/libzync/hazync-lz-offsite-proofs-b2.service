[Unit]
Description=Hazync libzync board: mirror new proof receipts to Backblaze B2 (second copy) under proofs-46666b6f/ (append-only), then check nothing is missing
After=network-online.target hazync-lz-coordinator.service
Wants=network-online.target
OnFailure=hazync-alert@%n.service

[Service]
# REORG.md §9 (P5): --depth 6 uploads only what is 6 blocks below the node's tip (/var/lib/hazync/node_tip, the coordinator's
# own); a proof or head of a branch a deeper reorg orphans is covered by a marker (reorgs/<E>.json), its successor goes
# to r<E>/. A stale tip file uploads nothing and fails the unit.
Type=oneshot
# Root only for reading the root-only key file; the proofs directory is world-readable.
ExecStart=/usr/bin/python3 /opt/hazync-lz/coordinator/deploy/hazync-offsite-proofs.py copy --keys /etc/hazync/backup/b2.keys --bucket hazync-backup --proofs /var/lib/hazync-lz/proofs --method-id 46666b6f7e3d1c1c3fa599a9bcf12209e0730d6a2fb747b8bf30fac667e43c1c --depth 6 --tip-file /var/lib/hazync/node_tip --threads 8 --bwlimit-mbit 64
# The check fails the unit (and so alerts) if any proof older than the grace period is still not in R2.
# 30 min grace: a proof written just after the copy listed the directory is caught by the next hourly run.
ExecStart=/usr/bin/python3 /opt/hazync-lz/coordinator/deploy/hazync-offsite-proofs.py check --keys /etc/hazync/backup/b2.keys --bucket hazync-backup --proofs /var/lib/hazync-lz/proofs --method-id 46666b6f7e3d1c1c3fa599a9bcf12209e0730d6a2fb747b8bf30fac667e43c1c --depth 6 --tip-file /var/lib/hazync/node_tip --min-age 1800
# A normal hourly run uploads a few thousand ~230 KB files. The cap ensures a stalled run becomes a failed
# unit before the next firing, not a silently stuck one (hazync#123).
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/hazync-lz/proofs /opt/hazync-lz
