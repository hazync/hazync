[Unit]
Description=libzync board pass: a leaf bundle for EVERY block from genesis under 46666b6f, paced by proving (the libzync board's bridge)
After=bitcoind.service libzync-board-fetch.service
Wants=libzync-board-fetch.service

[Service]
Type=simple
Environment=LZ_ROOT=/srv/bulk/libzync-board LZ_HI=974936
Environment=HAZYNC_PREP_SAVE_EVERY=250 HAZYNC_PREP_REPORT_EVERY=10000 HAZYNC_PREP_MIN_FREE_GB=250
# at most this many leaf bundles waiting to be proved: the pass pauses until the board's pruner removes proven ones
Environment=HAZYNC_PREP_LEAF_WINDOW=5000
# a rewind (REORG.md §5, P4) waits for the board coordinator's ack, which it writes here (it runs as hazync and cannot
# write this run's out/); the same directory as the coordinator's HAZYNC_LZ_REORG_ACK_DIR
Environment=HAZYNC_REORG_ACK_DIR=/var/lib/hazync-lz/reorg-acks
ExecStart=/bin/sh -c 'exec "$LZ_ROOT/bin/libzync-prep-run.sh"'
# exit 3 = the free-space floor, exit 4 = a reorg (docs/libzync/REORG.md §11): no restart, the unit fails and alerts
Restart=on-failure
RestartPreventExitStatus=3 4
RestartSec=30
# the main (paper) prep run on this box comes first
Nice=19
IOSchedulingClass=idle
# ⚠ The free-slot lists grow with height (docs/libzync/PREP_MEMORY.md): even at SAVE_EVERY 250 this cap needs
# raising before the pass nears ~640k (ESTIMATE), or prep is killed at every save point for ever.
MemoryHigh=10G
MemoryMax=14G
# if the box runs out, kill the pass first: it resumes from its newest save point by itself
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
