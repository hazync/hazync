[Unit]
Description=Hazync engine prep's block source: bitcoind blocks as block_<h>.json, a window ahead of hazync-engine-prep
After=bitcoind.service
OnFailure=hazync-alert@%n.service

[Service]
Type=simple
# LZ_WINDOW > HAZYNC_PREP_SAVE_EVERY (prep deletes block files only at save points)
Environment=LZ_ROOT=/srv/bulk/hazync-engine-prep LZ_HI=977800 LZ_WINDOW=1500 LZ_JOBS=4
Environment=HAZYNC_RPC_COOKIE=/var/lib/bitcoind/.cookie
ExecStart=/bin/sh -c 'exec /usr/bin/python3 "$LZ_ROOT/bin/fetch_block_rpc.py" range 1 "$LZ_HI" "$LZ_ROOT/blocks" --window "$LZ_WINDOW" --jobs "$LZ_JOBS" --after-saves "$LZ_ROOT/out"'
Restart=on-failure
RestartPreventExitStatus=4
RestartSec=30
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
