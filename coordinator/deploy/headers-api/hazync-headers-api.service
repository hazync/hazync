# The MMR path service for the Block check on hazync.org/headers/ (README.md here). UNTRUSTED by design: the browser
# checks every path against the peaks of the proof it verified. Read-only, GET only, bound to 127.0.0.1 by default.
[Unit]
Description=Hazync header chain: MMR paths for the Block check (untrusted; the browser verifies them)
After=bitcoind.service network-online.target
Wants=network-online.target
# the cookie is read at start (LoadCredential): restart with bitcoind, which writes a new one
PartOf=bitcoind.service

[Service]
Type=simple
DynamicUser=yes
StateDirectory=hazync-headers-api
LoadCredential=cookie:/var/lib/bitcoind/.cookie
Environment=HEADERS_DIR=/var/lib/hazync-headers
Environment=STATE_DIR=/var/lib/hazync-headers-api
Environment=RPC_URL=http://127.0.0.1:8332/
Environment=BIND=127.0.0.1
Environment=PORT=8902
Environment=RATE=5
Environment=BURST=20
# Behind nginx on ANOTHER box: set BIND to this box's address, TRUSTED_PROXIES to the web box, and allow only the web
# box to this port in the firewall (README.md, "Behind nginx").
Environment=TRUSTED_PROXIES=127.0.0.1,::1
ExecStart=/usr/bin/python3 /opt/hazync-headers/bin/hazync-headers-api
Restart=on-failure
RestartSec=10
Nice=10
# 975,279 hashes and every MMR level: ~62 MB of hashes, a few hundred MB with Python's overhead during the first sync
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
ReadOnlyPaths=/var/lib/hazync-headers

[Install]
WantedBy=multi-user.target
