#!/usr/bin/env python3
"""MMR paths for the header-chain proof, for the Block check on hazync.org/headers/.

UNTRUSTED BY DESIGN: nothing it says is believed. The browser (or `swiftsync-verify headers`) first verifies the
header-chain receipts itself, then checks each answer against the MMR peaks those receipts commit to
(verifyHeaders({..., include}), swiftsync-verify headers.rs):
  /path  the hash the READER asked about (never this service's `hash`), at the height asked, with this `path`, must
         climb to the committed peak for that height (the path's length is fixed by the height and the tip), so a
         wrong, stale or invented path, hash or height is refused;
  /tx    the same for the transaction's block, and: the 80-byte `header` must hash to that block; the `raw`
         transaction must parse, must not be 64 bytes, and must hash to the txid the READER asked about (this
         service's `txid` field is not read); the raw `coinbase` must be a coinbase whose `coinbase_branch` reaches
         the header's merkle root, which pins the tree's depth; and `branch`, exactly as deep, must lead from the
         asked txid at `pos` to the same root.
`leaves`, `mmr_root`, `tip_hash` and `hash` are for display and debugging only; the verifier derives what it needs.
A lying service can refuse to answer or answer wrongly (the browser then says "refused"); it cannot make a block or a
transaction look included. This service only saves the browser from holding a million block hashes.

It keeps the MMR of block hashes 0..T in memory, where T is the tip the follower PUBLISHED (the first field of
$HEADERS_DIR/published, written by hazync-headers-follow after the run verified), not the node's newest block, so a
path leads to the peaks of the receipts the page reads. The hashes come from the node by batched JSON-RPC and are
cached in $STATE_DIR/hashes.bin (32 bytes each, internal order); a restart reads the cache and fetches only new ones.
New hashes are taken only with their headers, linked: each fetched header hashes to its hash and names the one before
as its previous block, down to the last held hash (a reorg during the fetch would otherwise leave stale hashes in the
middle for good); a break drops the fetch and fetches again.

/tx needs the node to run with txindex=1 (getrawtransaction <txid> finds a confirmed transaction's block). It costs
the node getblock <hash> 1 (the txids) and two raw lookups, cached for the last TX_CACHE blocks, on an RPC connection
of its own: a slow /tx never holds up the sync. It is rate limited harder than /path (TX_RATE, TX_BURST), and at most
one /tx at a time talks to the node (others wait up to 10 s, then 503).

The node's cookie is read per call; under systemd that is the LoadCredential copy made at start, so a cookie that
went stale (bitcoind restarted without this unit) is answered 401 for ever. After AUTH_FAILS syncs in a row get 401
the service exits non-zero, and systemd (Restart=on-failure) starts it again with a fresh copy.

The MMR is the header-chain guest's (hazync repo, prover/zyncapps/methods/headers/src/mmr.rs):
  leaf = SHA256(0x00 || block hash), node = SHA256(0x01 || l || r), root = peaks bagged right to left with
  SHA256(0x02 || peak || acc). Every level is kept whole (level j holds the nodes over aligned runs of 2^j leaves),
  so a path is one lookup per level, and a path for an earlier tip is the same lookups.

  GET /path?h=<height>[&tip=<t>]   {height, hash, tip, leaves, path, mmr_root}   (tip defaults to the published one)
  GET /tx?txid=<txid>[&tip=<t>]    the same for the transaction's block, plus {txid, pos, header, raw, branch,
                                   coinbase, coinbase_branch}: what swiftsync-verify's TxInclusion::from_json reads
  GET /status                      {tip, tip_hash, leaves, mmr_root, ready}

Hashes are hex as explorers print them (reversed); path entries are raw-order hex (as zyncapp headers-mmr-path
prints them); branch entries are reversed hex (as Electrum's blockchain.transaction.get_merkle). Read-only, GET only,
rate limited per client (the first X-Forwarded-For address when the peer is a trusted proxy), bound to $BIND (127.0.0.1 by
default; on hazync-proof its own address, firewalled to the web box: README.md).

Environment: BIND (127.0.0.1), PORT (8902), HEADERS_DIR (/var/lib/hazync-headers), STATE_DIR (/var/lib/hazync-headers-api),
RPC_URL (http://127.0.0.1:8332/), RPC_COOKIE (the node's .cookie; under systemd, $CREDENTIALS_DIRECTORY/cookie),
POLL (30 s), RATE (requests per second per client, 5), BURST (20), TX_RATE (/tx per second per client, 0.2), TX_BURST
(5), TX_CACHE (blocks, 16), AUTH_FAILS (3), TRUSTED_PROXIES (127.0.0.1,::1).
"""
import base64, collections, hashlib, http.client, http.server, json, os, re, sys, threading, time, urllib.parse

env = os.environ.get
BIND, PORT = env('BIND', '127.0.0.1'), int(env('PORT', '8902'))
HEADERS_DIR = env('HEADERS_DIR', '/var/lib/hazync-headers')
STATE_DIR = env('STATE_DIR', '/var/lib/hazync-headers-api')
RPC_URL = urllib.parse.urlsplit(env('RPC_URL', 'http://127.0.0.1:8332/'))
_cred = env('CREDENTIALS_DIRECTORY')
RPC_COOKIE = env('RPC_COOKIE', os.path.join(_cred, 'cookie') if _cred else '/var/lib/bitcoind/.cookie')
POLL, RATE, BURST = float(env('POLL', '30')), float(env('RATE', '5')), float(env('BURST', '20'))
TX_RATE, TX_BURST, TX_CACHE = float(env('TX_RATE', '0.2')), float(env('TX_BURST', '5')), int(env('TX_CACHE', '16'))
AUTH_FAILS = int(env('AUTH_FAILS', '3'))
TRUSTED = set(env('TRUSTED_PROXIES', '127.0.0.1,::1').split(','))
BATCH = 2000


def log(*a):
    print(time.strftime('[%Y-%m-%dT%H:%M:%SZ]', time.gmtime()), *a, flush=True)


def sha(b):
    return hashlib.sha256(b).digest()


def dsha(b):
    return sha(sha(b))


def leaf(h):
    return sha(b'\x00' + h)


def node(l, r):
    return sha(b'\x01' + l + r)


def bag(peaks):
    if not peaks:
        return bytes(32)
    acc = peaks[-1]
    for p in reversed(peaks[:-1]):
        acc = sha(b'\x02' + p + acc)
    return acc


def peak_of(n, i):
    """(peak position, peak height k, index inside the peak) of leaf i among n leaves, or None."""
    if not 0 <= i < n:
        return None
    off = pos = 0
    for k in range(n.bit_length() - 1, -1, -1):
        if n >> k & 1:
            if i < off + (1 << k):
                return pos, k, i - off
            off += 1 << k
            pos += 1
    return None


class MMR:
    """Block hashes and every MMR level, each level one bytearray of 32-byte entries (level j: n >> j entries)."""

    def __init__(self):
        self.hashes = bytearray()
        self.levels = [bytearray()]

    def __len__(self):
        return len(self.hashes) // 32

    def append(self, h):
        self.hashes += h
        self.levels[0] += leaf(h)
        j = 0
        while len(self.levels[j]) // 32 % 2 == 0:
            if len(self.levels) == j + 1:
                self.levels.append(bytearray())
            lv = self.levels[j]
            self.levels[j + 1] += node(bytes(lv[-64:-32]), bytes(lv[-32:]))
            j += 1

    def truncate(self, n):
        del self.hashes[n * 32:]
        for j, lv in enumerate(self.levels):
            del lv[(n >> j) * 32:]

    def at(self, j, i):
        return bytes(self.levels[j][i * 32:i * 32 + 32])

    def hash(self, i):
        return bytes(self.hashes[i * 32:i * 32 + 32])

    def path(self, i, n):
        """Siblings of leaf i up to its peak in the MMR of the first n leaves (n <= len(self))."""
        _, k, _ = peak_of(n, i)
        return [self.at(j, (i >> j) ^ 1) for j in range(k)]

    def peaks(self, n):
        out, off = [], 0
        for k in range(n.bit_length() - 1, -1, -1):
            if n >> k & 1:
                out.append(self.at(k, off >> k))
                off += 1 << k
        return out


def disp(b):
    return b[::-1].hex()


class AuthError(RuntimeError):
    """The node refused the cookie (HTTP 401)."""


class Busy(RuntimeError):
    """Another caller held this connection's lock too long."""


class RPC:
    """One serialised JSON-RPC connection to the node. The sync and /tx each have their own, so a slow /tx (a big
    block) never holds up the sync; `wait` bounds how long a caller queues for the lock (None: as long as it takes)."""

    def __init__(self, timeout=120, wait=None):
        self.lock = threading.Lock()
        self.timeout, self.wait = timeout, wait

    def call(self, calls):
        """A JSON-RPC batch; raises on any error. The cookie is read per call (it changes when bitcoind restarts)."""
        with open(RPC_COOKIE, 'rb') as f:
            auth = base64.b64encode(f.read().strip()).decode()
        body = json.dumps([{'jsonrpc': '1.0', 'id': i, 'method': m, 'params': p} for i, (m, p) in enumerate(calls)])
        if not self.lock.acquire(timeout=-1 if self.wait is None else self.wait):
            raise Busy('the node is busy with another request')
        try:
            c = http.client.HTTPConnection(RPC_URL.hostname, RPC_URL.port or 8332, timeout=self.timeout)
            try:
                c.request('POST', RPC_URL.path or '/', body, {'Authorization': 'Basic ' + auth, 'Content-Type': 'application/json'})
                r = c.getresponse()
                data = r.read()
            finally:
                c.close()
        finally:
            self.lock.release()
        if r.status == 401:
            raise AuthError('rpc: HTTP 401 (the node refused the cookie)')
        if r.status not in (200, 500):
            raise RuntimeError(f'rpc: HTTP {r.status}')
        out = sorted(json.loads(data), key=lambda x: x['id'])
        return out

    def ok(self, calls):
        out = self.call(calls)
        for x in out:
            if x.get('error'):
                raise RuntimeError(f"rpc: {x['error'].get('message', x['error'])}")
        return [x['result'] for x in out]

    def one(self, method, *params):
        return self.ok([(method, list(params))])[0]


class State:
    def __init__(self):
        self.mmr = MMR()
        self.rpc = RPC()                          # the sync's
        self.rpc_tx = RPC(timeout=20, wait=10)    # /tx's: never the sync's lock
        self.blocks = collections.OrderedDict()   # block hash -> (height, raw header, txids, raw coinbase): an LRU
        self.blocks_lock = threading.Lock()
        self.auth_fails = 0
        self.lock = threading.RLock()
        self.tip = -1            # the published tip the MMR is at
        self.tip_hash = None
        self.error = 'starting'
        self.cache = os.path.join(STATE_DIR, 'hashes.bin')

    def published(self):
        with open(os.path.join(HEADERS_DIR, 'published')) as f:
            t, x = f.read().split()[:2]
        return int(t), x.lower()

    def load_cache(self):
        try:
            with open(self.cache, 'rb') as f:
                data = f.read()
        except FileNotFoundError:
            return
        for i in range(len(data) // 32):
            self.mmr.append(data[i * 32:i * 32 + 32])
        log(f'cache: {len(self.mmr)} hashes')

    def save_cache(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = self.cache + '.tmp'
        with open(tmp, 'wb') as f:
            f.write(self.mmr.hashes)
        os.replace(tmp, self.cache)

    def fetch(self, lo, hi, prev):
        """Node hashes lo..hi (inclusive), internal order, LINKED: each comes with its 80-byte header, which must hash
        to it and name the hash before it (`prev`, the held hash lo - 1, for the first; none below genesis). A reorg
        while the batches are fetched shows as a break in that chain: None, and the caller fetches again. Without
        it a reorg mid-fetch could leave old-branch hashes in the middle for good, under a correct top."""
        out = []
        for s in range(lo, hi + 1, BATCH):
            hs = self.rpc.ok([('getblockhash', [h]) for h in range(s, min(s + BATCH, hi + 1))])
            try:
                raws = self.rpc.ok([('getblockheader', [x, False]) for x in hs])
            except AuthError:
                raise
            except RuntimeError:   # a hash the node no longer knows: it moved under us
                return None
            for x, r in zip(hs, raws):
                b = bytes.fromhex(x)[::-1]
                hdr = bytes.fromhex(r)
                if len(hdr) != 80 or dsha(hdr) != b or (prev is not None and hdr[4:36] != prev):
                    return None
                out.append(b)
                prev = b
        return out

    def sync(self):
        """Bring the MMR to the published tip. On a reorg below what is held, drop back to where the node agrees.
        While the held hashes are being changed, or do not end on the published hash, nothing is served (503): a path
        is only ever given from hashes that end on the published tip."""
        t, tx = self.published()
        if t == self.tip and tx == self.tip_hash:
            return
        # Only this thread changes the MMR, so it reads it unlocked and fetches without holding the lock (a first
        # sync of the whole chain takes minutes; requests keep being answered from the last good tip meanwhile).
        n = min(len(self.mmr), t + 1)
        # where the held hashes stop agreeing with the node: check the top, step back on a mismatch
        while n > 0 and disp(self.mmr.hash(n - 1)) != self.rpc.one('getblockhash', n - 1):
            n = max(0, n - 100)
        fresh = []
        if n <= t:
            for attempt in range(3):
                fresh = self.fetch(n, t, self.mmr.hash(n - 1) if n > 0 else None)
                if fresh is not None:
                    break
                log(f'the node\'s chain moved during the fetch of {n}..{t} (a reorg): fetching again')
                # the held top may be on the old branch too: step back to where the node agrees again
                while n > 0 and disp(self.mmr.hash(n - 1)) != self.rpc.one('getblockhash', n - 1):
                    n = max(0, n - 100)
            else:
                raise RuntimeError(f'the node\'s chain kept moving during the fetch of {n}..{t}: trying again later')
        with self.lock:
            if n < len(self.mmr):
                log(f'dropping {len(self.mmr) - n} held hashes above {n - 1} (a reorg, or a lower published tip)')
            if n < len(self.mmr) or fresh:
                self.tip, self.tip_hash = -1, None
                self.mmr.truncate(n)
                for h in fresh:
                    self.mmr.append(h)
            if len(self.mmr) != t + 1 or disp(self.mmr.hash(t)) != tx:
                self.tip, self.tip_hash = -1, None
                raise RuntimeError(f'the node\'s hash at the published tip {t} is not the published {tx}')
            self.tip, self.tip_hash, self.error = t, tx, None
            self.save_cache()
            log(f'at the published tip {t} {tx}: {len(self.mmr)} leaves, root {self.mmr_root(t + 1).hex()}')

    def mmr_root(self, n):
        return bag(self.mmr.peaks(n))

    def sync_once(self):
        """One sync; an error is kept for /status. AUTH_FAILS 401s in a row: exit non-zero, for systemd to restart
        the unit with a fresh copy of the cookie (LoadCredential copies it only at start)."""
        try:
            self.sync()
            self.auth_fails = 0
        except AuthError as e:
            self.auth_fails += 1
            self.error = str(e)
            log('sync:', e, f'({self.auth_fails} in a row)')
            if self.auth_fails >= AUTH_FAILS:
                log(f'the node refused the cookie {self.auth_fails} times in a row: exiting for a restart with a fresh one')
                os._exit(3)
        except Exception as e:  # keep serving the last good tip; /status shows the error
            self.auth_fails = 0
            self.error = str(e)
            log('sync:', e)

    def loop(self):
        while True:
            time.sleep(POLL)
            self.sync_once()

    # ---- answers -------------------------------------------------------------------------------------------
    def answer_path(self, h, tip):
        with self.lock:
            if self.tip < 0:
                return 503, {'error': self.error or 'not ready'}
            t = self.tip if tip is None else tip
            if not 0 <= t <= self.tip:
                return 400, {'error': f'tip {t} is not in 0..{self.tip} (the published tip)'}
            if not 0 <= h <= t:
                return 404, {'error': f'block {h} is not in 0..{t}'}
            n = t + 1
            return 200, {'height': h, 'hash': disp(self.mmr.hash(h)), 'tip': t, 'tip_hash': disp(self.mmr.hash(t)),
                         'leaves': n, 'path': [p.hex() for p in self.mmr.path(h, n)], 'mmr_root': self.mmr_root(n).hex()}

    def block(self, bh):
        """(height, raw header hex, txids as hex, raw coinbase hex) of block bh, from the LRU or the node: getblock
        <hash> 1 (txids only; verbosity 2 would send every transaction of the block), the raw header, and the raw
        coinbase by its block (no txindex needed for that one). All of it is fixed by the block hash, so a cached
        entry never goes stale; whether the block is on the held chain is checked per answer (answer_tx)."""
        with self.blocks_lock:
            if bh in self.blocks:
                self.blocks.move_to_end(bh)
                return self.blocks[bh]
        blk, raw = self.rpc_tx.ok([('getblock', [bh, 1]), ('getblockheader', [bh, False])])
        cb = self.rpc_tx.ok([('getrawtransaction', [blk['tx'][0], False, bh])])[0]
        out = (blk['height'], raw, list(blk['tx']), cb)
        with self.blocks_lock:
            self.blocks[bh] = out
            while len(self.blocks) > TX_CACHE:
                self.blocks.popitem(last=False)
        return out

    def answer_tx(self, txid, tip):
        try:
            tx = self.rpc_tx.one('getrawtransaction', txid, True)
        except (AuthError, Busy):
            raise
        except Exception:
            return 404, {'error': f'transaction {txid} is not known to the node (or is unconfirmed; the node needs txindex=1)'}
        bh = tx.get('blockhash')
        if not bh:
            return 404, {'error': f'transaction {txid} is not in a block'}
        height, raw, ids, coinbase = self.block(bh)
        if txid not in ids:
            return 502, {'error': f'the node puts transaction {txid} in block {bh}, which does not hold it'}
        pos = ids.index(txid)
        # on the held chain (which ends on the published tip): the hash held at that height IS this block
        code, ans = self.answer_path(height, tip)
        if code != 200:
            return code, ans
        if ans['hash'] != bh:
            return 409, {'error': f'block {bh} is not the held block at {height}'}
        txids = [bytes.fromhex(x)[::-1] for x in ids]
        # the raw transaction and the raw coinbase with its branch: the coinbase pins the tree's depth, so the verifier can
        # refuse an inner merkle node presented as a transaction (swiftsync-verify headers.rs, verify_tx_in_header)
        return 200, {**ans, 'txid': txid, 'pos': pos, 'header': raw, 'raw': tx['hex'],
                     'branch': [disp(b) for b in merkle_branch(txids, pos)], 'coinbase': coinbase,
                     'coinbase_branch': [disp(b) for b in merkle_branch(txids, 0)]}


def merkle_branch(txids, pos):
    lv, out = list(txids), []
    while len(lv) > 1:
        if len(lv) % 2:
            lv.append(lv[-1])
        out.append(lv[pos ^ 1])
        lv = [dsha(lv[i] + lv[i + 1]) for i in range(0, len(lv), 2)]
        pos >>= 1
    return out


class Bucket:
    def __init__(self, rate, burst):
        self.lock, self.b = threading.Lock(), {}
        self.rate, self.burst = rate, burst

    def take(self, key):
        now = time.monotonic()
        with self.lock:
            if len(self.b) > 10000:
                self.b = {k: v for k, v in self.b.items() if now - v[1] < 60}
            tok, last = self.b.get(key, (self.burst, now))
            tok = min(self.burst, tok + (now - last) * self.rate)
            if tok < 1:
                self.b[key] = (tok, now)
                return False
            self.b[key] = (tok - 1, now)
            return True


STATE, BUCKET, TX_BUCKET = State(), Bucket(RATE, BURST), Bucket(TX_RATE, TX_BURST)
HEIGHT, HEX64 = re.compile(r'^[0-9]{1,9}$'), re.compile(r'^[0-9a-fA-F]{64}$')


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = 'hazync-headers-api'
    sys_version = ''

    def log_message(self, fmt, *a):
        pass

    def send(self, code, obj):
        body = (json.dumps(obj) + '\n').encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-cache')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(body)

    def client(self):
        peer = self.client_address[0]
        xff = self.headers.get('X-Forwarded-For')
        return xff.split(',')[0].strip() if xff and peer in TRUSTED else peer

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        if not BUCKET.take(self.client()):
            return self.send(429, {'error': 'too many requests'})
        u = urllib.parse.urlsplit(self.path)
        q = dict(urllib.parse.parse_qsl(u.query))
        route = u.path.rstrip('/').rsplit('/', 1)[-1]   # behind a proxy prefix (/headers-api/path) or not
        tip = q.get('tip')
        if tip is not None and not HEIGHT.match(tip):
            return self.send(400, {'error': 'tip: a height'})
        tip = None if tip is None else int(tip)
        try:
            if route == 'path':
                if not HEIGHT.match(q.get('h', '')):
                    return self.send(400, {'error': 'h: a height'})
                return self.send(*STATE.answer_path(int(q['h']), tip))
            if route == 'tx':
                if not HEX64.match(q.get('txid', '')):
                    return self.send(400, {'error': 'txid: 64 hex characters'})
                # each /tx costs the node a block's txids: limited harder than /path
                if not TX_BUCKET.take(self.client()):
                    return self.send(429, {'error': 'too many transaction requests'})
                try:
                    return self.send(*STATE.answer_tx(q['txid'].lower(), tip))
                except Busy as e:
                    return self.send(503, {'error': str(e)})
            if route == 'status':
                with STATE.lock:
                    n = STATE.tip + 1
                    return self.send(200, {'ready': STATE.tip >= 0, 'tip': STATE.tip, 'tip_hash': STATE.tip_hash,
                                           'leaves': n, 'mmr_root': STATE.mmr_root(n).hex() if n > 0 else None,
                                           'error': STATE.error})
        except Exception as e:
            log('request:', e)
            return self.send(502, {'error': 'the node did not answer'})
        return self.send(404, {'error': 'GET /path?h=<height>, /tx?txid=<txid>, /status'})

    def _refuse(self):
        self.send(405, {'error': 'read-only'})

    do_POST = do_PUT = do_DELETE = do_PATCH = _refuse


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 64


def main():
    STATE.load_cache()
    STATE.sync_once()
    threading.Thread(target=STATE.loop, daemon=True).start()
    srv = Server((BIND, PORT), Handler)
    log(f'listening on {BIND}:{PORT}')
    srv.serve_forever()


if __name__ == '__main__':
    sys.exit(main())
