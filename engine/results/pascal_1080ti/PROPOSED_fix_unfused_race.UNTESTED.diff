+// Hazync patch (28.11.2026): the apply_alpha + virtual first-layer branch of frac_build_tree_layer_kernel reads
+// layer[parent_start], layer[parent_start + 1] (parent_start = bit-reversed idx * 2) and writes layer[idx] (and a right
+// leaf) IN PLACE, ordered only by __syncthreads(), which orders one block. Upstream runs it only for <= 1024 leaves
+// (one block); the unfused path taken where the fused bitrev kernel cannot run (Pascal: no 64 KB of shared memory)
+// runs it on millions of leaves across many blocks, where one block can overwrite a slot another has not read yet
+// (the GTX 1080 Ti's NonzeroRootSum). This variant reads every input from a snapshot `src` of the dense layer: the
+// same values the single-block run reads, whatever the block order.
+__global__ void frac_build_tree_layer0_virtual_kernel(
+    FracExt *__restrict__ layer,
+    const FracExt *__restrict__ src,
+    uint32_t half,
+    uint32_t real_len,
+    uint32_t logical_len,
+    FpExt alpha
+) {
+    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= half) {
+        return;
+    }
+    const uint32_t parent_active_size = half;
+    const uint32_t parent_start = rev_len(idx, lg_pow2(parent_active_size)) << 1;
+    FracExt lhs_val = FracExt::zero();
+    FracExt rhs_val = FracExt::zero();
+    FracExt rhs_leaf = FracExt::zero();
+    bool has_rhs_leaf = false;
+    if (parent_start < real_len) {
+        lhs_val = src[parent_start];
+    }
+    if (parent_start + 1 < real_len) {
+        rhs_val = src[parent_start + 1];
+        rhs_leaf = rhs_val;
+        has_rhs_leaf = true;
+    }
+    lhs_val.q += alpha;
+    rhs_val.q += alpha;
+    frac_add_inplace(lhs_val, rhs_val);
+    virtual_node_store(layer, idx, parent_active_size, real_len, logical_len, lhs_val);
+    if (has_rhs_leaf) {
+        rhs_leaf.q += alpha;
+        virtual_node_store(layer, idx + half, logical_len, real_len, logical_len, rhs_leaf);
+    }
+}
