+// Whether this device can give the fused kernel below its 64 KB of dynamic shared memory per block. Pascal (sm_6x)
+// allows 48 KB per block at most, so cudaFuncSetAttribute refuses there (cudaErrorInvalidValue): the caller then
+// takes the unfused path (separate bitrev + layer 0), which computes the same tree layers (Hazync patch).
+extern "C" int _bit_rev_frac_ext_build_k2_supported()
+{
+    int device = 0, optin = 0;
+    if (cudaGetDevice(&device) != cudaSuccess) return 0;
+    if (cudaDeviceGetAttribute(&optin, cudaDevAttrMaxSharedMemoryPerBlockOptin, device) != cudaSuccess) return 0;
+    return (size_t)optin >= (size_t)256 * 8 * sizeof(FracExt) ? 1 : 0;
+}
