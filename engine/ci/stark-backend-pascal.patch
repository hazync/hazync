+/// Pascal). Hazync patch.
+pub fn bit_rev_frac_ext_build_k2_supported() -> bool {
+    // HZ_FORCE_UNFUSED_BITREV=1: take the unfused path on any device (to test it on a card that has the 64 KB).
+    if std::env::var("HZ_FORCE_UNFUSED_BITREV").map(|v| v == "1").unwrap_or(false) {
+        return false;
+    }
+    unsafe { _bit_rev_frac_ext_build_k2_supported() != 0 }
+}
