# GENERATED by engine/guest/assemble.sh from the product guest's Cargo.toml features; dependencies are the engine's.
[package]
name = "hazync-engine-guest"
version = "0.1.0"
edition = "2021"

[workspace]

[profile.release]
# No fat LTO (the product's guest has it, worth -0.7% there): the bitcode linker refuses the duplicate sys_sha_compress
# (OpenVM's std PAL stub + the engine's). Goes away with native SHA (no sys_sha_compress at all).
codegen-units = 1

[features]
default = ["serde", "libzync", "coinlog", "utxohash", "trie"]
serde = []
# libzync WITHOUT the RISC Zero coprocessor levers (bigint2-ecdsa, liftx-hint, field-bigint2, scalar-inv-accel); their
# engine counterparts are libsecp's hooks (secp-0201-openvm-batch-liftx.patch) and batch_ecdsa_ovm.rs.
libzync = ["agg-readslice", "batch-ecdsa", "tx-once", "swiftsync", "agg-lite", "fast-commit"]
agg-readslice = []
batch-ecdsa = []
tx-once = []
swiftsync = ["batch-ecdsa"]
agg-lite = ["swiftsync", "tx-once"]
fast-commit = []
coinlog = ["libzync"]
utxohash = ["coinlog"]
trie = ["coinlog"]
bigint2-ecdsa = []
liftx-hint = []
field-bigint2 = []
scalar-inv-accel = []
tx-cycles = []
signet = ["libzync"]
regtest = ["libzync"]
txlog = ["libzync"]
test-lineage = ["coinlog"]
xver-v3_0_5 = []
xver-v3_1_0 = []

[dependencies]
risc0-zkvm = { path = "@ENGINE@/platform/risc0-zkvm", package = "hazync-engine-platform" }
risc0-crypto = { path = "@ENGINE@/platform/risc0-crypto", package = "hazync-engine-crypto" }
sha2 = { path = "@ENGINE@/platform/sha2", package = "hazync-engine-sha2", features = ["compress"] }
serde = { version = "1", default-features = false, features = ["derive", "alloc"] }
openvm = { git = "https://github.com/openvm-org/openvm.git", tag = "v2.1.0", features = ["std"] }
openvm-algebra-guest = { git = "https://github.com/openvm-org/openvm.git", tag = "v2.1.0" }
openvm-ecc-guest = { git = "https://github.com/openvm-org/openvm.git", tag = "v2.1.0" }
k256 = { git = "https://github.com/openvm-org/openvm.git", tag = "v2.1.0", package = "k256" }

[build-dependencies]
cc = "1"
