+/** ENGINE (hazync engine/openvm, core-0201): SHA-256 compression on OpenVM's SHA-256 extension in Core's OWN state
+ *  layout. zkvm_sha256_impl(state, block, out) takes and returns the state as 8 native (little-endian) uint32 words --
+ *  exactly Core's `uint32_t s[8]` -- and the 64 raw message bytes as the block, so no byte swaps; in place
+ *  (out == state) is how OpenVM's own sha2 calls it. The instruction needs 4-byte aligned pointers (zkvm_sha256_impl
+ *  would heap-copy an unaligned one): an unaligned chunk is staged in a local block. Replaces RISC Zero's
+ *  sys_sha_compress (state byte-swapped) used by patches 0002/0009/0010/libzync-0101. */
+extern "C" void zkvm_sha256_impl(const unsigned char* state, const unsigned char* input, unsigned char* output);
+
 // Internal implementation code.
 namespace
 {
+inline void hz_ovm_compress(uint32_t* s, const unsigned char* chunk, size_t blocks)
+{
+    alignas(4) unsigned char blk[64];
+    while (blocks--) {
+        const unsigned char* in = chunk;
+        if ((((uintptr_t)chunk) & 3u) != 0u) { __builtin_memcpy(blk, chunk, 64); in = blk; }
+        zkvm_sha256_impl((const unsigned char*)s, in, (unsigned char*)s);
+        chunk += 64;
+    }
+}
+/* A native state word -> its 4 digest bytes (big-endian), as byte stores: no __bswapsi2 libcall (rv32im has no
+ * byte-reverse instruction) and safe for an unaligned destination. */
+inline void hz_ovm_be32(unsigned char* p, uint32_t x)
+{
+    p[0] = (unsigned char)(x >> 24); p[1] = (unsigned char)(x >> 16); p[2] = (unsigned char)(x >> 8); p[3] = (unsigned char)x;
+}
