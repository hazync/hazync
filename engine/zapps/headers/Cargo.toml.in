# GENERATED by engine/zapps/headers/assemble.sh: the header zyncAPP's guest on the engine. Dependencies are the
# engine's; the zAPP's own (prover/zyncapps/methods/headers/Cargo.toml): serde, crypto-bigint, sha2, risc0-zkvm.
[package]
name = "zyncapp-headers-engine"
version = "0.1.0"
edition = "2021"

[workspace]

[profile.release]
lto = "fat"
codegen-units = 1

[dependencies]
risc0-zkvm = { path = "@ENGINE@/platform/risc0-zkvm", package = "hazync-engine-platform" }
sha2 = { path = "@ENGINE@/platform/sha2", package = "hazync-engine-sha2", features = ["compress"] }
serde = { version = "1", default-features = false, features = ["derive", "alloc"] }
crypto-bigint = { version = "0.5", default-features = false }
openvm = { git = "https://github.com/openvm-org/openvm.git", tag = "v2.1.0", features = ["std"] }
