# engine/handover/verifier-guest (HANDOVER.md step 1): OpenVM's verifier inside an engine guest. Generated by
# engine/handover/assemble.sh: @ENGINE@ = the engine dir, @OVM@ = OpenVM v2.1.0 with engine/wasm-verify/
# openvm-abi-stable.patch and engine/handover/openvm-verify-nozstd.patch applied.
[package]
name = "hazync-handover-verifier"
version = "0.1.0"
edition = "2021"

[workspace]

[profile.release]
lto = "fat"
codegen-units = 1

[dependencies]
risc0-zkvm = { path = "@ENGINE@/platform/risc0-zkvm", package = "hazync-engine-platform" }
openvm = { git = "https://github.com/openvm-org/openvm.git", tag = "v2.1.0", features = ["std"] }
openvm-verify-stark-host = { path = "@OVM@/crates/verify", default-features = false }
openvm-stark-sdk = { version = "2.1.0", git = "https://github.com/openvm-org/stark-backend.git", tag = "v2.1.0", default-features = false }
bitcode = { version = "0.6", features = ["serde"] }
sha2 = { version = "0.10", default-features = false }
